	<script>
		function getStatus(testId, examineeTeststatus, examineeUserId, examineeName)
		{
			if(examineeTeststatus == 0)
			{
				return "Yet to start";
			}
			else if(examineeTeststatus == 1)
			{
				return "In progress - <a onclick='viewResult(\""+testId+"\",\""+examineeUserId+"\",\""+examineeName+"\")' style='cursor:pointer;' title='View result'>View result</a>";
			}
			else if(examineeTeststatus == 2)
			{
				return "Submitted - <a onclick='viewResult(\""+testId+"\",\""+examineeUserId+"\",\""+examineeName+"\")' style='cursor:pointer; color:green;' title='View result'>View result</a>";
			}
		}
		
		function callExamineesStatus(testId, testName)	//Declaration of the data table function
		{		
			$('#example').DataTable().clear().destroy();
			$("#example tbody").empty();
			$.ajax({
					url: 'getExamineesStatus.php',
					type: 'POST',
					data: {testId : testId},
					dataType: 'JSON',
					success: function(response)
					{
						if(!response || !Array.isArray(response))
						{
							response = [];
						}
						var len = response.length;
						for(var i=0; i<len; i++){
							var testId = response[i].testId;
							var examineeUserId = response[i].examineeUserId;
							var examineeName = response[i].examineeName || "Unknown";
							var classAndYearGroupName = response[i].classAndYearGroupName || "Unknown";
							var testDate = response[i].testDate || "";						
							var duration = response[i].duration || "";						
							var timeStarted = response[i].timeStarted || "";						
							var timeSubmitted = response[i].timeSubmitted || "";						
							var remainingTime = response[i].remainingTime || 0;						
							var examineeTeststatus = response[i].examineeTeststatus || 0;						
							
							var tr_str = "<tr>" +
								"<td width='4'><center>" + (i+1) + "</center></td>" +
								"<td width='15'><center>" + examineeName + "</center></td>" +
								"<td width='13'><center>" + classAndYearGroupName + "</center></td>" +
								"<td width='16'><center>" + testDate + "</center></td>" +
								"<td width='8'><center>" + duration + " minutes</center></td>" +
								"<td width='8'><center>" + timeStarted + "</center></td>" +
								"<td width='8'><center>" + timeSubmitted + "</center></td>" +
								"<td width='10'><center>" + remainingTime + " minutes</center></td>" +
								"<td width='18'><center>" + getStatus(testId, examineeTeststatus, examineeUserId, examineeName) + "</center></td>" +
							"</tr>";

							$("#example tbody").append(tr_str);
						}
						$('#example').DataTable( {
						"paging":   true,
						"ordering": true,
						"info":     true,
						"responsive": true,
						dom: 'lBfrtip',
						buttons: [
							'copy', 'csv', 'excel', 'pdf', 'print'
						],
						rowReorder: {
								selector: 'td:nth-child(2)'
							},
							"responsive": true
						});
						$('.message4').html('');
						if(len == 0)
						{
							$('.message4').html('<i class="fa fa-info-circle"></i> No students found for this test.');
						}
					},
					error: function(xhr, status, error)
					{
						console.error("Error loading examinees status:", error);
						$('.message4').html('<i class="fa fa-exclamation-circle"></i> Error loading data. Please try again.');
						$("#example tbody").empty();
						$('#example').DataTable( {
							"paging":   true,
							"ordering": true,
							"info":     true,
							"responsive": true
						});
					}
			});
		}
		//callExamineesStatus();
		
		//function call to open modal for editing a category
		function openEditModal(testId, testName, testDate, duration, startHour, startMinute, isAmOrPm, subjectId, yearGroupId, theReviewOption)
        {
            var modal1 = document.getElementById("myModal1");
			document.getElementById("testId").value = testId;  
			document.getElementById("testName1").value = testName;  
			document.getElementById("testDate1").value = testDate;  
			document.getElementById("testDuration1").value = duration;  
			$("#startHour1 option[value="+startHour+"]").attr('selected', 'selected');
			$("#startMinute1 option[value="+startMinute+"]").attr('selected', 'selected');
			$("#amOrPm1 option[value="+isAmOrPm+"]").attr('selected', 'selected');
			$("#subjectId1 option[value="+subjectId+"]").attr('selected', 'selected');
			$("#yearGroup1 option[value="+yearGroupId+"]").attr('selected', 'selected');
			$("#reviewOption1 option[value="+theReviewOption+"]").attr('selected', 'selected');
                
            modal1.style.display = "block";
        }
		var span1 = document.getElementsByClassName("close1")[0];
            
        // When the user clicks on <span> (x), close the modal1
        span1.onclick = function() {
			modal1.style.display = "none";
        }
            
        // When the user clicks anywhere outside of the modal, close it
        var modal1 = document.getElementById("myModal1");
        window.onclick = function(event) {
            if (event.target == modal1) {
                modal1.style.display = "none";
            }
        }
		
		//Returning a font awesome icon depending on the status of the answer
		function getAnswerStatus(markStatus)
		{
			if(markStatus == 1)
			{
				return "<i class='fa fa-check' style='color:green; font-size:18px;'></i>";
			}
			else if(markStatus == 2)
			{
				return "<i class='fa fa-times' style='color:red; font-size:18px;'></i>";
			}
			else if(markStatus == 3)
			{
				return "<i class='fa fa-minus' style='color:#888888; font-size:18px;'></i>";
			}
		}
		
		//function to get text if an option is selected or not.
		function getSelectionText(selectedOption)
		{
			if(selectedOption == 0)
			{
				return "Not answered";
			}
			else if(selectedOption == "")
			{
				return "Not viewed";
			}
			else
			{
				return selectedOption;
			}
		}
		
		//function call to open modal viewing students' test questions answers
		function viewResult(testId, examineeUserId, examineeName)
        {
			$('#example1').DataTable().clear().destroy();
            var modal1 = document.getElementById("myModal1");
            var form_data = 'testId='+testId;
			
			$.ajax({
					url: "getStudentquestionsResult.php",
				type: "POST",        
				data: {testId : testId, examineeUserId : examineeUserId},
				dataType: 'JSON',
				success: function (response) {
					if(!response || !Array.isArray(response))
					{
						response = [];
					}
					var len = response.length;
					
					var totalMarkToBeEarned = 0;
					var totalMarkedObtained = 0;
					
					for(var i=0; i<len; i++){
						var questionId = response[i].questionId;
						var question = response[i].question;
						var optionA = response[i].optionA;
						var optionB = response[i].optionB;
						var optionC = response[i].optionC;						
						var optionD = response[i].optionD;											
						var correctOption = response[i].correctOption;						
						var selectedOption = response[i].selectedOption;						
						var markStatus = response[i].markStatus;						
						var mark = +response[i].mark;
						var markObtained = +response[i].markObtained;

						totalMarkToBeEarned = totalMarkToBeEarned + mark;
						totalMarkedObtained = totalMarkedObtained + markObtained;						
							
						var tr_str = "<tr style='color:#000000;'>" +
							"<td width='4%'><center>" + (i+1) + "</center></td>" +
							"<td width='30%'><center>" + question + "</center></td>" +
							"<td width='10%'><center>" + optionA + "</center></td>" +
							"<td width='10%'><center>" + optionB + "</center></td>" +
							"<td width='10%'><center>" + optionC + "</center></td>" +
							"<td width='10%'><center>" + optionD + "</center></td>" +
							"<td width='8%'><center>" + correctOption + "</center></td>" +
							"<td width='8%'><center>" + getSelectionText(selectedOption) + "</center></td>" +
							"<td width='5%'><center>" + getAnswerStatus(markStatus) + "</center></td>" +
							"<td width='5%'><center>" + markObtained + "</center></td>" +
						"</tr>";

						$("#example1 tbody").append(tr_str);
					}
					$('#example1').DataTable( {
					"paging":   true,
					"ordering": true,
					"info":     true,
					"responsive": true,
					dom: 'lBfrtip',
					buttons: [
						'copy', 'csv', 'excel', 'pdf', 'print'
					],
					rowReorder: {
							selector: 'td:nth-child(2)'
						},
						"responsive": true
					});
					
					var percentageScore = Math.round((totalMarkedObtained/totalMarkToBeEarned) * 100);
					$("#totalMarkToBeEarned").html(totalMarkToBeEarned);
					$("#totalObtained").html(totalMarkedObtained);
					$("#percentageScore").html('('+percentageScore+'%)');
				},
				error: function(xhr, status, error)
				{
					console.error("Error loading student questions result:", error);
					alert("Error loading student results. Please try again.");
				}				
			});
			$("#examineeName").html(examineeName);
			modal1.style.display = "block";
		}		
		
		//Fetching students of a test based on selected test
		$('#testId').on('change', function(){
			$('.message1').html('');
			$('.message2').html('');
			$('.message4').html('');
			
			var testId = document.getElementById('testId').value;
			var testName = $("#testId option:selected").text();
			if(testId == "")
			{
				$("#testNameHere").html("");
				$('#example').DataTable().clear().destroy();
				$("#example tbody").empty();
			}
			else
			{
				$("#testNameHere").html(testName);
				$('.message4').html('<i class="fa fa-spinner fa-spin"></i> Loading...');
				callExamineesStatus(testId, testName);
			}
		});

		//Functiont to view results of
		function viewCompleteExamineesResult()
		{
			$('#example2').DataTable().clear().destroy();
            
			var testId = document.getElementById('testId').value;
			var testName1 = $("#testId option:selected").text();
			if (testId == "")
			{
				$('.message5').html('<i class="fa fa-info-circle"></i> Please select test first')
			}
			else
			{
				$.ajax({
					url: "getAllStudentsResults.php",
					type: "POST",        
					data: {testId : testId},
					dataType: 'JSON',
					success: function (response) {
						if(!response || !Array.isArray(response))
						{
							response = [];
						}
						var len = response.length;
						for(var i=0; i<len; i++){
							var studentId = response[i].studentId;
							var studentName = response[i].studentName;
							var totalQuestionsToBeAnswered = response[i].totalQuestionsToBeAnswered;
							var totalQuestionsAnswered = Number(response[i].totalQuestionsAnswered);
							var totalQuestionsAnsweredCorrectly = Number(response[i].totalQuestionsAnsweredCorrectly);
							var totalQuestionsAnsweredAndFailed = Number(response[i].totalQuestionsAnsweredAndFailed);
							var totalQuestionsNotAnswered = response[i].totalQuestionsNotAnswered;
							var totalmarksToBeEarned = response[i].totalmarksToBeEarned;						
							var totalMarksEarned = response[i].totalMarksEarned;											
							var percentageScore = response[i].percentageScore;						
								
							var totalQuestionsToBeAnsweredDisplayed = "";
							if(totalQuestionsToBeAnswered == 0)
							{
								totalQuestionsToBeAnsweredDisplayed = "Not attempted";
							}
							else
							{
								totalQuestionsToBeAnsweredDisplayed = totalQuestionsToBeAnswered;
							}
							var tr_str = "<tr style='color:#000000;'>" +
								"<td width='4%'><center>" + (i+1) + "</center></td>" +
								"<td width='10%'><center>" + studentName + "</center></td>" +
								"<td width='10%'><center>" + totalQuestionsToBeAnsweredDisplayed + "</center></td>" +
								"<td width='10%'><center>" + totalQuestionsAnswered + "</center></td>" +
								"<td width='10%'><center>" + totalQuestionsAnsweredCorrectly + "</center></td>" +
								"<td width='10%'><center>" + totalQuestionsAnsweredAndFailed + "</center></td>" +
								"<td width='10%'><center>" + totalQuestionsNotAnswered + "</center></td>" +
								"<td width='10%'><center>" + totalmarksToBeEarned + "</center></td>" +
								"<td width='10%'><center>" + totalMarksEarned + "</center></td>" +
								"<td width='8%'><center>" + percentageScore + "%</center></td>" +
							"</tr>";
							$("#example2 tbody").append(tr_str);
						}
						$('#example2').DataTable( {
							"paging":   true,
							"ordering": true,
							"info":     true,
							"responsive": true,
							dom: 'lBfrtip',
							buttons: [
								'copy', 'csv', 'excel', 'pdf', 'print'
							],
							rowReorder: {
									selector: 'td:nth-child(2)'
								},
								"responsive": true
						});

						
						$("#testName").html(testName1);
						var modal2 = document.getElementById("myModal2");
						modal2.style.display = "block";
					},
					error: function(xhr, status, error)
					{
						console.error("Error loading all students results:", error);
						$('.message5').html('<i class="fa fa-exclamation-circle"></i> Error loading results. Please try again.');
					}				
				});
			}
		}
		var modal2 = document.getElementById("myModal2");
		var span2 = document.getElementsByClassName("close2")[0];
            
        // When the user clicks on <span> (x), close the modal1
        span2.onclick = function() {
			modal2.style.display = "none";
        }
	</script>
	


  </body>
</html>
